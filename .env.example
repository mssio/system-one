# mock: in-browser fake Jev answers (default). http: call the FastAPI proxy.
VITE_API_MODE=mock

# Used when VITE_API_MODE=http. No trailing path; the client posts to /v1/systemone.
VITE_API_BASE_URL=http://localhost:8000

# Logto. When these are missing, or when VITE_API_MODE is mock, the app runs
# without authentication so it can be used locally.
VITE_LOGTO_ENDPOINT=https://your-tenant.logto.app
VITE_LOGTO_APP_ID=
# API resource identifier configured in Logto. Sent as the audience when
# requesting an access token for the backend.
VITE_LOGTO_RESOURCE=https://api.system-one.local
